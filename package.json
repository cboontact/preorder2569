{
  "name": "chomthong-school-supplies",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:api": "node scripts/test-api.mjs && node scripts/test-permissions.mjs && node scripts/test-terms.mjs",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "node scripts/check-account.mjs && npm run build:worker && opennextjs-cloudflare deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "node scripts/check-account.mjs && wrangler d1 migrations apply DB --remote",
    "cf:whoami": "wrangler whoami"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@opennextjs/cloudflare": "1.20.6",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260917.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  },
  "engines": {
    "node": ">=22"
  }
}
